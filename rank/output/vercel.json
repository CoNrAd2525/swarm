{
  "version": 2,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/courses", "dest": "/courses.html" },
    { "src": "/courses/", "dest": "/courses.html" },
    { "src": "/articles", "dest": "/articles/index.html" },
